{
  "name": "contentlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "cd backend && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "format": "pnpm --dir frontend format",
    "typecheck": "pnpm --dir frontend typecheck",
    "db:start": "supabase start -x logflare,vector,realtime",
    "db:reset": "supabase db reset --local",
    "types:db": "supabase gen types typescript --local > frontend/src/types/database.generated.ts"
  }
}
